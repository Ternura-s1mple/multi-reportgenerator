# ================================================
# .gitignore for Full-Stack Python/React Project
# ================================================

# --- 敏感信息 / Secrets ---
# 绝对禁止提交任何包含密钥的环境变量文件
.env
*.env
.env.*

# --- Python / Backend 忽略项 ---
# 忽略 Conda / venv 虚拟环境文件夹
.venv/
venv/
env/

# 忽略 Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# 忽略数据库文件 (非常重要)
*.db
*.sqlite3
.chroma_db/

# 忽略生成的报告和用户上传的模板
storage/
uploads/

# 忽略本地知识库 (推荐，除非是小型公开示例)
backend/knowledge_base/

# 忽略模型缓存
backend/.cache/

# --- Node.js / Frontend 忽略项 ---
# 忽略所有npm依赖包 (非常大)
node_modules/

# 忽略编译后的生产文件
dist/
.vite/

# 忽略日志文件和调试报告
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# --- IDE / OS 忽略项 ---
# 忽略VSCode, PyCharm等编辑器的配置文件夹
.vscode/
.idea/

# 忽略macOS和Windows的系统文件
.DS_Store
Thumbs.db